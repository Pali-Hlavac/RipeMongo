{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimal permissions for the main window. Grant each new app command explicitly.",
  "windows": ["main"],
  "permissions": [
    "core:event:default",
    "allow-get-app-info",
    "allow-get-settings",
    "allow-update-settings",
    "allow-list-connections",
    "allow-save-connection",
    "allow-delete-connection",
    "allow-duplicate-connection",
    "allow-get-stored-secrets",
    "allow-parse-connection-string",
    "allow-build-connection-string",
    "allow-test-connection",
    "allow-open-connection",
    "allow-close-connection",
    "allow-list-active-connections",
    "allow-export-connections",
    "allow-inspect-connections-file",
    "allow-import-connections",
    "dialog:allow-open",
    "dialog:allow-save",
    "allow-list-databases",
    "allow-create-database",
    "allow-drop-database",
    "allow-list-collections",
    "allow-collection-stats",
    "allow-create-collection",
    "allow-create-view",
    "allow-drop-collection",
    "allow-rename-collection",
    "allow-find-documents",
    "allow-count-documents",
    "allow-sample-fields",
    "allow-list-queries",
    "allow-record-query",
    "allow-save-favorite-query",
    "allow-delete-favorite-query",
    "allow-insert-documents",
    "allow-replace-document",
    "allow-set-document-field",
    "allow-delete-document",
    "allow-preview-update-many",
    "allow-update-many",
    "allow-preview-delete-many",
    "allow-delete-many",
    "allow-get-tools-info",
    "allow-list-jobs",
    "allow-get-job-log",
    "allow-cancel-job",
    "allow-dismiss-job",
    "allow-start-dump",
    "allow-inspect-dump",
    "allow-start-restore",
    "allow-start-export",
    "allow-inspect-import-file",
    "allow-start-import",
    "allow-list-dump-profiles",
    "allow-save-dump-profile",
    "allow-delete-dump-profile",
    "allow-run-dump-profile"
  ]
}
